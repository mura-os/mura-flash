{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mura.dev/schemas/transcript-event-v1.schema.json",
  "title": "Mura Flash canonical transcript event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sessionId",
    "sequence",
    "timestamp",
    "previousHash",
    "payload",
    "eventHash"
  ],
  "properties": {
    "schema": {
      "const": "org.mura.flash.transcript-event/v1"
    },
    "sessionId": {
      "$ref": "#/$defs/id"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"
    },
    "previousHash": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "procedureId",
            "flowId"
          ],
          "properties": {
            "kind": {
              "const": "session-start"
            },
            "procedureId": {
              "$ref": "#/$defs/id"
            },
            "flowId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "operationId",
            "variant"
          ],
          "properties": {
            "kind": {
              "const": "operation-start"
            },
            "operationId": {
              "$ref": "#/$defs/id"
            },
            "variant": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "operationId",
            "variant",
            "durationMs"
          ],
          "properties": {
            "kind": {
              "const": "operation-would-execute"
            },
            "operationId": {
              "$ref": "#/$defs/id"
            },
            "variant": {
              "$ref": "#/$defs/id"
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "operationId",
            "outputs",
            "durationMs"
          ],
          "properties": {
            "kind": {
              "const": "operation-success"
            },
            "operationId": {
              "$ref": "#/$defs/id"
            },
            "outputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/typedValue"
              }
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "operationId",
            "failureClass",
            "durationMs"
          ],
          "properties": {
            "kind": {
              "const": "operation-failure"
            },
            "operationId": {
              "$ref": "#/$defs/id"
            },
            "failureClass": {
              "$ref": "#/$defs/id"
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "fromStateId",
            "toStateId",
            "operationId"
          ],
          "properties": {
            "kind": {
              "const": "state-transition"
            },
            "fromStateId": {
              "$ref": "#/$defs/id"
            },
            "toStateId": {
              "$ref": "#/$defs/id"
            },
            "operationId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "confirmationId",
            "accepted"
          ],
          "properties": {
            "kind": {
              "const": "confirmation"
            },
            "confirmationId": {
              "$ref": "#/$defs/id"
            },
            "accepted": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "gate",
            "allowed"
          ],
          "properties": {
            "kind": {
              "const": "policy-gate"
            },
            "gate": {
              "$ref": "#/$defs/id"
            },
            "allowed": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "recoveryId",
            "trigger"
          ],
          "properties": {
            "kind": {
              "const": "recovery-start"
            },
            "recoveryId": {
              "$ref": "#/$defs/id"
            },
            "trigger": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "terminalStateId",
            "errorCode"
          ],
          "properties": {
            "kind": {
              "const": "session-end"
            },
            "terminalStateId": {
              "$ref": "#/$defs/id"
            },
            "errorCode": {
              "oneOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "eventHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,95}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "typedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]{0,63}$"
        },
        "type": {
          "$ref": "#/$defs/id"
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      }
    }
  }
}

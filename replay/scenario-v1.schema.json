{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mura.dev/schemas/replay-scenario-v1.schema.json",
  "title": "Mura Flash deterministic replay scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "procedureId",
    "flowId",
    "simulateDisabled",
    "clock",
    "operationDurations",
    "adapterCapabilities",
    "inputs",
    "responses",
    "expected"
  ],
  "properties": {
    "schema": {
      "const": "org.mura.flash.replay-scenario/v1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "procedureId": {
      "$ref": "#/$defs/id"
    },
    "flowId": {
      "$ref": "#/$defs/id"
    },
    "adapterCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/typedValue"
      }
    },
    "responses": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "operationId",
              "outputs"
            ],
            "properties": {
              "kind": {
                "const": "success"
              },
              "operationId": {
                "$ref": "#/$defs/id"
              },
              "outputs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/typedValue"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "operationId",
              "failureClass"
            ],
            "properties": {
              "kind": {
                "const": "failure"
              },
              "operationId": {
                "$ref": "#/$defs/id"
              },
              "failureClass": {
                "$ref": "#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "afterOperationId"
            ],
            "properties": {
              "kind": {
                "const": "interruption"
              },
              "afterOperationId": {
                "$ref": "#/$defs/id"
              }
            }
          }
        ]
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminalStateId",
        "eventKinds",
        "errorCode"
      ],
      "properties": {
        "terminalStateId": {
          "$ref": "#/$defs/id"
        },
        "eventKinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "errorCode": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "simulateDisabled": {
      "const": true
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startTimestamp",
        "tickMs"
      ],
      "properties": {
        "startTimestamp": {
          "type": "string",
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"
        },
        "tickMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "operationDurations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "durationMs"
        ],
        "properties": {
          "operationId": {
            "$ref": "#/$defs/id"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,95}$"
    },
    "typedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9.-]{0,95}$"
        },
        "type": {
          "$ref": "#/$defs/id"
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      }
    }
  }
}

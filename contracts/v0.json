  "deniedOperationClasses": [
    "arbitrary-command",
    "device-code-execution",
    "device-transition",
    "device-write"
  ],
  "limits": {
    "probeTimeoutSeconds": 10,
    "reconnectTimeoutSeconds": 10,
    "maxOutputBytes": 1048576,
    "maxDevices": 1
  },
  "errorCodes": {
    "usage": 2,
    "recipe-invalid": 2,
    "device-missing": 3,
    "device-ambiguous": 3,
    "probe-failed": 4,
    "probe-timeout": 4,
    "safety-refusal": 5
  },
  "cli": {
    "commands": ["targets", "show", "validate", "inspect"],
    "jsonFlag": "--json"
  },
  "esmExports": [
    "loadCatalog",
    "getTarget",
    "validateRecipe",
    "createBrowserSession",
    "redactTranscript"
  ]
}

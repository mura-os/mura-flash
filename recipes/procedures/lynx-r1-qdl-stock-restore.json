{
  "schema": "org.mura.flash.install-procedure/v1",
  "id": "lynx-r1-qdl-stock-restore",
  "targetId": "lynx-r1",
  "enabled": false,
  "sourceBehavior": {
    "summary": "Lynx documents a full stock restore using the firmware package's prog_firehose_ddr.elf, rawprogram_unsparse0.xml, rawprogram1.xml through rawprogram5.xml, and patch0.xml through patch5.xml on UFS. Linux temporarily disables ModemManager, starts qdl, and enters EDL with adb reboot edl; if port selection fails, Power + Volume Up + Volume Down exposes QDLoader 9008. Erase All Before Download must remain off to avoid losing distortion and calibration files.",
    "evidenceLevel": "vendor-documented"
  },
  "muraPolicy": {
    "writeBoundary": "Live use is unavailable. The official 1.4.1 package is currently unavailable, every package-member SHA-256 is unknown, rawprogram/patch contents and exact GPT/partition coverage are uninspected, and no pre-write Firehose backup or calibration completeness proof exists. All-zero digests explicitly mean unknown and block live use.",
    "liveDestructiveAllowed": false
  },

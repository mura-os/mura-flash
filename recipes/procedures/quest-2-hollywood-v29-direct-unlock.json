{
  "schema": "org.mura.flash.install-procedure/v1",
  "id": "quest-2-hollywood-v29-direct-unlock",
  "targetId": "quest-2-hollywood",
  "enabled": false,
  "sourceBehavior": {
    "summary": "Source direct mode chooses Quest 2 solely because oem device-info reports bootloader build 16476800118700000. It derives the Hollywood-specific payload, sends it immediately before flash:unlock_token, treats getvar:unlocked OR oem device-info Device unlocked as true, and trusts only the state after a clean bootloader restart.",
    "evidenceLevel": "source-documented"
  },
  "muraPolicy": {
    "writeBoundary": "Research-only source parity. Direct mode has build-only identification and no inactive-slot backup context. Mura additionally requires target and same-unit identity, hardware qualification, authenticated stock provenance, separate activation/reset confirmations, exact recovery, and rollback readback.",
    "liveDestructiveAllowed": false
  },

  "sourceBehavior": {
    "summary": "A single community guide reports success on displayed release 1.0.999.738: enable launcher USB debugging, run four exact ADB provisioning commands, enable OEM unlocking in Android settings, reboot to fastboot, run fastboot flashing unlock and approve it on-device, then perform the required recovery factory reset and optionally observe Device State: Unlocked.",
    "evidenceLevel": "community-reported"
  },

{
  "schema": "org.mura.flash.install-procedure/v1",
  "id": "oculus-go-pacific-official-unlock",
  "targetId": "oculus-go-pacific",
  "enabled": false,
  "sourceBehavior": {
    "summary": "Meta's Go-only procedure extracts the official outer package, sideloads unlocked_build.zip from recovery, reboots to the bootloader, runs fastboot oem unlock with the device-side wipe confirmation, and then checks that fastboot flash and adb root are accepted. Unlock permanently ends OTA service; relocking wipes again and accepts only Oculus-signed boot images.",
    "evidenceLevel": "vendor-documented"
  },
  "muraPolicy": {
    "writeBoundary": "The official package URL is not represented by an acquired SHA-256-bound artifact, and the retail partition/protected-state map and tested stock restore are unknown. All-zero digests explicitly mean unknown and block live use. Mura does not offer relock without an administrator-controlled trust root.",
    "liveDestructiveAllowed": false
  },
  "states": [
    {
      "id": "stock-go-adb",
      "kind": "device-mode",
      "initial": true
    },
    {
      "id": "recovery-sideload",

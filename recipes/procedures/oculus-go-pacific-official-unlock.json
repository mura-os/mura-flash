        "kind": "unknown",
        "reason": "No authenticated SHA-256 digest is available from the cited source."
      }
    },
    {
      "id": "oculus-go-unlocked-build-inner",
      "role": "payload",
      "source": {
        "kind": "local",
        "path": "Oculus_Go_SW_Unlock_v1.zip!/unlocked_build.zip"
      },
      "digest": {
        "kind": "unknown",
        "reason": "No authenticated SHA-256 digest is available from the cited source."
      }
    }
  ],

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mura.dev/schemas/inspection-recipe-v1.schema.json",
  "title": "Mura inspection target recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "displayName",
    "vendor",
    "models",
    "codenames",
    "builds",
    "evidenceLevel",
    "hardwareStatus",
    "authenticationStatus",
    "writesEnabled",
    "frontends",
    "transports",
    "probes",
    "redactFacts",
    "blockers",
    "unknowns",
    "sources"
  ],
  "properties": {
    "schema": {
      "const": "org.mura.flash.inspection-recipe/v1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "vendor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "models": {
      "$ref": "#/$defs/stringList"
    },
    "codenames": {
      "$ref": "#/$defs/stringList"
    },
    "builds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "status": {
            "enum": [
              "eligible-reported",
              "ineligible-reported",
              "inspect-only",
              "unknown",
              "unsupported"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "evidenceLevel": {
      "enum": [
        "source-documented",
        "vendor-documented",
        "community-reproduced",
        "community-reported"
      ]
    },
    "hardwareStatus": {
      "enum": ["unqualified", "unsupported"]
    },
    "authenticationStatus": {
      "const": "test-only"
    },
    "writesEnabled": {
      "const": false
    },
    "frontends": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["python", "webusb"]
      }
    },
    "transports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["adb", "fastboot", "manual"]
      }
    },
    "probes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "redactFacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "blockers": {
      "$ref": "#/$defs/stringList"
    },
    "unknowns": {
      "$ref": "#/$defs/stringList"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,79}$"
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  }
}
